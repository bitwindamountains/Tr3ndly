ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./tr3ndly.db
# Bearer token for every route except /health. Required (32+ chars) in production.
# The web app sends it from apps/web/.env.local as API_OPERATOR_TOKEN.
OPERATOR_TOKEN=

# Worker. Comma-separated source slugs; leave empty to disable all sources.
ENABLED_SOURCES=open-meteo,ph-calendar
# Required in production: Open-Meteo's free API is non-commercial.
OPEN_METEO_API_KEY=
WORKER_TICK_SECONDS=60
MIN_TIMELY_SCORE=70

# Copy generation. Without a key, deterministic templates write the copy.
ANTHROPIC_API_KEY=
COPY_MODEL=claude-opus-5-5
# Appended to every exported caption.
AFFILIATE_DISCLOSURE=I may earn a commission from purchases made through my link.
# Export requires the listing to have been re-confirmed live within this many hours.
LISTING_RECHECK_HOURS=72

# Add only when the corresponding source/provider is enabled.
OPENAI_API_KEY=
NEWSAPI_KEY=
SENTRY_DSN=


ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./tr3ndly.db
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Worker. Comma-separated source slugs; leave empty to disable all sources.
ENABLED_SOURCES=open-meteo
# Required in production: Open-Meteo's free API is non-commercial.
OPEN_METEO_API_KEY=
WORKER_TICK_SECONDS=60
MIN_TIMELY_SCORE=65

# Add only when the corresponding source/provider is enabled.
OPENAI_API_KEY=
NEWSAPI_KEY=
SENTRY_DSN=


# Copy to apps/web/.env.local. All values are server-side; none reach the browser.
API_BASE_URL=http://localhost:8000
# Must equal the API's OPERATOR_TOKEN when that is set.
API_OPERATOR_TOKEN=

# Operator sign-in. Leave OPERATOR_PASSWORD empty to disable sign-in (local development only).
OPERATOR_PASSWORD=
# 32+ random characters, used to sign the session cookie.
SESSION_SECRET=
